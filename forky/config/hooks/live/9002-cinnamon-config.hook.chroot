#!/usr/bin/env bash
set -e

mkdir -p /etc/dconf/db/local.d

cat > /etc/dconf/db/local.d/00-trios-theme <<'EOF'
[org/cinnamon/theme]
name='TriOS-Orchis-Dark'

[org/cinnamon/desktop/interface]
gtk-theme='TriOS-Orchis-Dark'
icon-theme='TriOS-Slot-Dark'
color-scheme='prefer-dark'

[org/cinnamon/desktop/background]
picture-uri='file:///usr/share/backgrounds/TriOS/TriOS.svg'
picture-uri-dark='file:///usr/share/backgrounds/TriOS/TriOS.svg'
picture-options='zoom'

[org/x/apps/portal]
color-scheme='prefer-dark'

[org/cinnamon/sounds]
login-enabled=true
login-file='/etc/trios/sounds/Startup.wav'
notification-enabled=true
notification-file='/etc/trios/sounds/Activate.wav'
plug-enabled=true
plug-file='/etc/trios/sounds/Activate.wav'
switch-enabled=true
switch-file='/etc/trios/sounds/Whoosh.wav'
tile-enabled=true
tile-file='/etc/trios/sounds/Click.wav'
unplug-enabled=true
unplug-file='/etc/trios/sounds/Deactivate.wav'
EOF

mkdir -p /etc/dconf/profile

cat > /etc/dconf/profile/user <<'EOF'
user-db:user
system-db:local
EOF

dconf update   
