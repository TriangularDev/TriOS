#!/usr/bin/env bash
set -e

dpkg --add-architecture i386 # Add multiarch support (for Steam)

wget -q https://packages.mozilla.org/apt/repo-signing-key.gpg -O- | sudo tee /etc/apt/keyrings/packages.mozilla.org.asc > /dev/null # Add Mozilla signing keys

echo "deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main" | sudo tee -a /etc/apt/sources.list.d/mozilla.list > /dev/null # Add Mozilla repository

wget -O - https://dl.winehq.org/wine-builds/winehq.key | sudo gpg --dearmor -o /etc/apt/keyrings/winehq-archive.key - # Add Wine signing keys

sudo wget -NP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/debian/dists/forky/winehq-forky.sources # Add Wine sources (thank you for supporting Forky natively)

apt-get update # Pull from updated software repositories

apt-get install -y --install-recommends \
	mesa-vulkan-drivers \
	mesa-vulkan-drivers:i386 \
	libgl1-mesa-dri \
	libgl1-mesa-dri:i386 \
	libglx-mesa0 \
	libglx-mesa0:i386 \
	libegl1 \
	libegl1:i386 \
	libvulkan1 \
	libvulkan1:i386 \
	vulkan-tools \
	mesa-utils \
	pipewire \
	pipewire-audio \
	wireplumber \
	libpulse0 \
	libpulse0:i386 \
	libopenal1 \
	libopenal1:i386 \
	libsdl2-2.0-0 \
	libsdl2-2.0-0:i386 \
	libudev1 \
	libudev1:i386 \
	zenity \
	cabextract \
	fonts-liberation \
	fonts-noto \
	gamemode \
	mangohud \
	gamescope \
	inxi \
	winehq-staging \
	firefox # Install set of default apps

sudo apt-get purge firefox-esr

curl -s https://liquorix.net/install-liquorix.sh | sudo bash # Install liquorix kernel

apt-get upgrade
